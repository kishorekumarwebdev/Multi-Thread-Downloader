{
  "version": 3,
  "name": "multi-thread-downloader",
  "builds": [
    {
      "src": "frontend_v3/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend_v3/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
